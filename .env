# Core
SECRET_KEY=generate-a-long-random-secret
MAX_UPLOAD_MB=20
UPLOAD_FOLDER=storage/files
WEB_SESSION_HOURS=24

# PostgreSQL (Render / Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase Storage - recommended for production persistence
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_BUCKET=voidkage-documents

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=YOUR_RANDOM_WEBHOOK_SECRET
WEB_URL=https://voidkage.onrender.com
TELEGRAM_SESSION_MINUTES=60
PASSWORD_SETUP_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Set false only for local HTTP testing. Keep true on Render HTTPS.
SESSION_COOKIE_SECURE=true
